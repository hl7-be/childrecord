       fhir:short [ fhir:v "Who is responsible for the observation" ] ;
       fhir:definition [ fhir:v "Who was responsible for asserting the observed value as \"true\"." ] ;
       fhir:comment [ fhir:v "When the specific performer is not known, the organisation can be used. \nWhen a device is creating the entry, `.device` should identify the device, and `.performer` should identify the person responsible for (using) the device, e.g. the professional or patient.\nIn cases where the performer is known but there is no resource or unique identifier, the reference.display can be used - although this should be avoided." ] ;
       fhir:requirements [ fhir:v "May give a degree of confidence in the observation and also indicates where follow-up questions should be directed." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:base [
