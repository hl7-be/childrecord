       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Bundle.total" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "unsignedInt"^^xsd:anyURI ;
           fhir:l fhir:unsignedInt
