       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "effectiveTime" ]
       ] )
     ] [
       fhir:id [ fhir:v "Bundle.entry:inTreatmentWithOphthalmologist.resource.issued" ] ;
