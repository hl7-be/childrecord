       fhir:path [ fhir:v "Bundle.entry.resource.code" ] ;
       fhir:short [ fhir:v "Intracranial injury" ] ;
       fhir:definition [ fhir:v "Describes what was observed. Sometimes this is called the observation \"name\".\r\n\r\nFor providing systems, it is RECOMMENDED to express this using a code and consuming software SHALL record this.\r\nIn general, it shall be noted SNOMED-CT is the preferred national terminology. Other coding systems remain allowed or MAY be preferred in specific flows (e.g. the use of LOINC codes to express a laboratory test.)" ] ;
       fhir:comment [ fhir:v "*All* code-value and, if present, component.code-component.value pairs need to be taken into account to correctly understand the meaning of the observation." ] ;
       fhir:requirements [ fhir:v "Knowing what kind of observation is being made is essential to understanding the observation." ] ;
       fhir:alias ( [ fhir:v "Name" ] ) ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
