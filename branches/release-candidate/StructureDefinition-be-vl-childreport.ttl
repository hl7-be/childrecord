     ] [
       fhir:id [ fhir:v "Bundle.entry:eyeRemarks.resource.code" ] ;
       fhir:path [ fhir:v "Bundle.entry.resource.code" ] ;
       fhir:short [ fhir:v "Eye remarks" ] ;
       fhir:definition [ fhir:v "Describes what was observed. Sometimes this is called the observation \"name\".\r\n\r\nFor providing systems, it is RECOMMENDED to express this using a code and consuming software SHALL record this.\r\nIn general, it shall be noted SNOMED-CT is the preferred national terminology. Other coding systems remain allowed or MAY be preferred in specific flows (e.g. the use of LOINC codes to express a laboratory test.)" ] ;
       fhir:comment [ fhir:v "*All* code-value and, if present, component.code-component.value pairs need to be taken into account to correctly understand the meaning of the observation." ] ;
       fhir:requirements [ fhir:v "Knowing what kind of observation is being made is essential to understanding the observation." ] ;
       fhir:alias ( [ fhir:v "Name" ] ) ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Observation.code" ] ;
         fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "CodeableConcept"^^xsd:anyURI ;
           fhir:l fhir:CodeableConcept
         ]
       ] ) ;
       fhir:pattern [
         a fhir:CodeableConcept ;
         fhir:coding ( [
           fhir:system [
             fhir:v "https://www.ehealth.fgov.be/standards/fhir/terminology/CodeSystem/cs-child-report-documentation"^^xsd:anyURI ;
             fhir:l <https://www.ehealth.fgov.be/standards/fhir/terminology/CodeSystem/cs-child-report-documentation>
           ] ;
           fhir:code [ fhir:v "eye-remarks-observation" ]
         ] )
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ele-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "All FHIR elements must have a @value or children" ] ;
         fhir:expression [ fhir:v "hasValue() or (children().count() > id.count())" ] ;
         fhir:xpath [ fhir:v "@value|f:*|h:div" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Element"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Element>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v true ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName>
           ] ;
           fhir:value [
             a fhir:String ;
             fhir:v "ObservationCode"
           ]
         ] ) ;
         fhir:strength [ fhir:v "example" ] ;
         fhir:description [ fhir:v "Codes identifying names of simple observations." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/observation-codes|4.0.1"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/observation-codes?version=4.0.1>
         ]
       ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "workflow" ] ;
         fhir:map [ fhir:v "Event.code" ]
       ] [
         fhir:identity [ fhir:v "w5" ] ;
         fhir:map [ fhir:v "FiveWs.what[x]" ]
       ] [
         fhir:identity [ fhir:v "sct-concept" ] ;
         fhir:map [ fhir:v "< 363787002 |Observable entity| OR < 386053000 |Evaluation procedure|" ]
       ] [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "OBX-3" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "code" ]
       ] [
         fhir:identity [ fhir:v "sct-attr" ] ;
         fhir:map [ fhir:v "116680003 |Is a|" ]
       ] )
     ] [
       fhir:id [ fhir:v "Bundle.entry:eyeRemarks.resource.subject" ] ;
       fhir:path [ fhir:v "Bundle.entry.resource.subject" ] ;
       fhir:short [ fhir:v "The child that is the subject of this document" ] ;
       fhir:definition [ fhir:v "The patient, or group of patients, location, or device this observation is about and into whose record the observation is placed. If the actual focus of the observation is different from the subject (or a sample of, part, or region of the subject), the `focus` element or the `code` itself specifies the actual focus of the observation." ] ;
       fhir:comment [ fhir:v "One would expect this element to be a cardinality of 1..1. The only circumstance in which the subject can be missing is when the observation is made by a device that does not know the patient. In this case, the observation SHALL be matched to a patient through some context/channel matching technique, and at this point, the observation should be updated." ] ;
       fhir:requirements [ fhir:v "Observations have no value if you don't know who or what they're about." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Observation.subject" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Reference"^^xsd:anyURI ;
           fhir:l fhir:Reference
         ] ;
         fhir:targetProfile ( [
