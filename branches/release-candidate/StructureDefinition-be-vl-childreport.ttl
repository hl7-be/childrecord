           ] ;
           fhir:code [ fhir:v "102972004" ] ;
           fhir:display [ fhir:v "Brain stem auditory evoked potential, function" ]
         ] )
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ele-1" ] ;
